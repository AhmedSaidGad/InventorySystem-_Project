@{
  
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentSearch = ViewBag.CurrentSearch ?? "";
    string actionName = ViewBag.ActionName ?? "Index";
}

@if (totalPages > 1)
{
    <div class="pagination-container">
        <ul class="pagination">
            @if (currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action(actionName, new { page = currentPage - 1, searchTerm = currentSearch })">Previous</a>
                </li>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action(actionName, new { page = i, searchTerm = currentSearch })">@i</a>
                </li>
            }

            @if (currentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action(actionName, new { page = currentPage + 1, searchTerm = currentSearch })">Next</a>
                </li>
            }
        </ul>
    </div>
}