@model List<InventorySystem.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Products";
}

<h2>Products List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Product</a>
</p>


<form method="get" asp-action="Index" class="form-inline mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control"
               placeholder="Search by SKU or Product Name..."
               value="@ViewBag.CurrentSearch" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>


<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>SKU</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Unit Price</th>
            <th>Stock</th>
            <th>Threshold</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductID</td>
                <td>@item.SKU</td>
                <td>@item.ProductName</td>
                <td>@item.CategoryName</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.StockQuantity</td>
                <td>@item.LowStockThreshold</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.ProductID" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.ProductID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@await Html.PartialAsync("_PaginationPartial")