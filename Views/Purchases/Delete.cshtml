@model InventorySystem.ViewModels.PurchaseViewModel

@{
    ViewData["Title"] = "Delete Purchase";
}

<h2>Delete Purchase</h2>
<h3>Are you sure you want to delete this?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.PurchaseID</dd>

        <dt class="col-sm-2">Supplier</dt>
        <dd class="col-sm-10">@Model.SupplierName</dd>

        <dt class="col-sm-2">Purchase Date</dt>
        <dd class="col-sm-10">@Model.PurchaseDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">Total Amount</dt>
        <dd class="col-sm-10">@Model.TotalAmount.ToString("C")</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="PurchaseID" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>