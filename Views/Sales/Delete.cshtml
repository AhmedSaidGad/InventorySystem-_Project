@model InventorySystem.ViewModels.SaleViewModel

@{
    ViewData["Title"] = "Delete Sale";
}

<h2>Delete Sale</h2>
<h3>Are you sure you want to delete this?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.SaleID</dd>

        <dt class="col-sm-2">Sale Date</dt>
        <dd class="col-sm-10">@Model.SaleDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">Customer Info</dt>
        <dd class="col-sm-10">@Model.CustomerInfo</dd>

        <dt class="col-sm-2">Total Amount</dt>
        <dd class="col-sm-10">@Model.TotalAmount.ToString("C")</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="SaleID" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>