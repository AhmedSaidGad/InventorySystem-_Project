@model List<InventorySystem.ViewModels.SaleViewModel>

@{
    ViewData["Title"] = "Sales";
}

<h2>Sales List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Sale</a>
</p>

<form method="get" asp-action="Index" class="form-inline mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control"
               placeholder="Search by Customer Info or Date..."
               value="@ViewBag.CurrentSearch" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>


<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Sale Date</th>
            <th>Customer Info</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SaleID</td>
                <td>@item.SaleDate.ToString("yyyy-MM-dd")</td>
                <td>@item.CustomerInfo</td>
                <td>@item.TotalAmount.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.SaleID" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.SaleID" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.SaleID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


@await Html.PartialAsync("_PaginationPartial")