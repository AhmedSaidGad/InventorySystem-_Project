@model List<InventorySystem.ViewModels.SupplierViewModel>

@{
    ViewData["Title"] = "Suppliers";
}

<h2>Suppliers List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Supplier</a>
</p>


<form method="get" asp-action="Index" class="form-inline mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control"
               placeholder="Search by name, contact, phone, email, or address..."
               value="@ViewBag.CurrentSearch" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Supplier Name</th>
            <th>Contact Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SupplierID</td>
                <td>@item.SupplierName</td>
                <td>@item.ContactName</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.Address</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.SupplierID" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.SupplierID" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.SupplierID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_PaginationPartial")